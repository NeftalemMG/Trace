# Required — Anthropic (Claude)
# console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Free — Perplexity (live web search, sonar model)
# perplexity.ai/settings/api — free credits, no credit card
PERPLEXITY_API_KEY=pplx-your-key-here

# Free — Google Gemini (gemini-1.5-flash)
# aistudio.google.com/app/apikey — completely free, no credit card
GEMINI_API_KEY=AIzaSy-your-key-here

# Paid — OpenAI ChatGPT (gpt-4o)
# platform.openai.com/api-keys — requires OpenAI account and credits
OPENAI_API_KEY=sk-your-key-here
